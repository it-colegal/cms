<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure HTTPS (uncomment if using HTTPS)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remove www from URL (optional)
    # RewriteCond %{HTTP_HOST} ^www\\.(.*)$ [NC]
    # RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

    # Prevent access to application folders
    RewriteRule ^(application|system|tests)(/|$) - [L,R=403]

    # Allow robots.txt and sitemap.xml
    RewriteCond %{REQUEST_FILENAME} robots\\.txt$ [OR]
    RewriteCond %{REQUEST_FILENAME} sitemap\\.xml$
    RewriteRule ^(.*)$ $1 [L]

    # Redirect to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# Disable directory browsing
Options -Indexes

# Set cache headers for static files
<FilesMatch "\\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>
